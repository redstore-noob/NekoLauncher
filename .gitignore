# 旧版前端备份（node_modules 体积过大，不入库）
frontend-vue-backup/node_modules/
frontend-vue-backup/dist/
frontend-vue-backup/package.json.md5
# 注意：不要整目录忽略 /build/ —— 里面的 appicon.png 与 windows/ 清单是
# wails build 的必需输入，忽略掉会让 CI/新克隆构建出默认图标。
# frontend/wailsjs 是 wails generate 的生成物，但刻意入库：CI 的前端检查
# （tsc/eslint）与无 wails CLI 的本地开发都依赖它，否则类型检查直接失败。

# 本地 Go 构建缓存（沙箱/CI 用 GOCACHE 指到工作区时产生）
/.gocache/
/.gomodcache/

# TS 增量构建缓存（tsc -p tsconfig.node.json 等的 tsbuildinfo）
*.tsbuildinfo

# 临时脚本 / 验证产物（本地排查 CI 之类时用，不入库）
/.tmp/
# 沙箱 ACL 修复产生的本地产物（诊断工具的输出，与仓库内容无关）
/.acl-recovery/
/acl-reports/

# NekoSolo 安装器构建产物
NekoSolo/NekoSolo.Installer/bin/
NekoSolo/NekoSolo.Installer/obj/
# 其它 .NET 风格构建目录（bin/obj）与临时输出
**/bin/
**/obj/
/out/

# 宣传素材（大体积视频/音频/渲染产物，本地制作不入库）
/promo/

# AI 工具的本地目录（各家编码助手的工作区文件，因人而异不入库）
.claude/
.cursor/
.continue/
.codeium/
.windsurf/
.trae/
.aider*
.copilot*
.zcode/

# WE 场景渲染 harness（scene_harness_main 的构建产物）
harness/

# WE 场景逆向调试残留：当前壁纸的 mdl/scene 转储与 testdata 下的工作草稿
# （含用户壁纸样本，绝不能入库；testdata/*.mdl 是测试正式输入，不受影响）
/puppet_cur.mdl
/scene_cur.json
internal/bindings/testdata/dump/

# 根目录 node_modules（前端各自的依赖见上方「前端」一节）
/node_modules/

# 本地 AI 工具 / DSH 工作区：插件依赖清单、profile 备份、调试转储与打包产物。
# 全是本机环境产物，与启动器源码无关；真要入库请 git add -f
/package.json
/pnpm-lock.yaml
/pnpm-workspace.yaml
/.profile-backup/
/dsh-profile-*/
/*.tgz
/dump-config-*.txt

# 根目录一次性排查脚本（本地按需重建；frontend/eslint.config.mjs 在子目录，不受影响）
/*.mjs

# 本地素材：徽章 / 宣传图源文件（同 /promo/，本地制作不入库；要入库 git add -f assets/）
/assets/
